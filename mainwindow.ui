      <widget class="QWidget" name="RegisterPage">
       <property name="styleSheet">
        <string notr="true">QFrame#registerCard {
    background-color: #141418;
    border: 1px solid #1f1f22;
    border-radius: 12px;
    padding: 25px;
}
QLineEdit {
    background-color: #1a1c20;
    border: 1px solid #00eaff;
    border-radius: 6px;
    padding: 6px;
    color: white;
    font-size: 16px;
}
QPushButton#btnRegisterConfirm {
    background-color: #141418;
    border: 2px solid #00eaff;
    border-radius: 10px;
    padding: 10px;
    color: white;
    font-size: 18px;
    font-weight: 500;
}

QPushButton#btnRegisterConfirm:hover {
    background-color: #00eaff;
    color: #0d0d0f;
}
QLabel#lblToLogin {
    color: #00eaff;
    font-size: 14px;
    text-decoration: underline;
}

QLabel#lblToLogin:hover {
    color: #66f0ff;
}
QLabel#lblRegisterTitle {
    font-size: 60px;
    font-weight: bold;
    letter-spacing: 1px;
	border-width: 2px;
}

</string>
