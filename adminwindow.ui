  <property name="styleSheet">
   <string notr="true">QWidget#AdminWindow{
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:1,
        stop:0 #0d0f12,
        stop:0.5 #0b0d10,
        stop:1 #0a0c0f
    );
}
QLabel#lblBanUnbanUser {
    font-size: 40px;
	font-weight: bold;
	border-width: 2px;
}
QLabel#lblDeleteUser {
    font-size: 40px;
	font-weight: bold;
	border-width: 2px;
}
QLabel#lblBanStatus {
    font-size: 20px;
	border-width: 2px;
}
QLabel#lblDeleteStatus {
    font-size: 20px;
	border-width: 2px;
}
QPushButton {
    background-color: #141418;
    border: 2px solid #00eaff;
    border-radius: 10px;
    padding: 10px 20px;
    color: white;
    font-size: 18px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #00eaff;
    color: #0d0d0f;
}

QPushButton:pressed {
    background-color: #0099aa;
}

QPushButton#btnLeaveAdmin {
    background-color: #141418;
    border: 2px solid #ff0000;
    border-radius: 10px;
    padding: 10px 20px;
    color: white;
    font-size: 18px;
    font-weight: 500;
}

QPushButton#btnLeaveAdmin:hover {
    background-color: #ff0000;
    color: #0d0d0f;
}

QPushButton#btnLeaveAdmin:pressed{
	background-color:#531516;
}</string>
